<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EyaInsightsApi</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="MySqlConnector" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- El asistente usa el mismo contrato (openapi.json) y las mismas instrucciones que el arnés de pruebas. -->
    <Content Include="..\openapi.json" Link="openapi.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="instrucciones.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
