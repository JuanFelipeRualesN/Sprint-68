<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyTitle>ReadingAPI</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ReadingAPI.Domain\Models\**" />
    <EmbeddedResource Remove="ReadingAPI.Domain\Models\**" />
