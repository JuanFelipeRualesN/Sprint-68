  "scripts": {
    "start:local": "env-cmd -f .env.local react-scripts start",
    "start:msj": "env-cmd -f .env.msj react-scripts start",
    "start:msj-uat": "env-cmd -f .env.msj-uat react-scripts start",
    "start:msj-dev": "env-cmd -f .env.msj-dev react-scripts start",
    "start:private": "env-cmd -f .env.private react-scripts start",
    "start:private-uat": "env-cmd -f .env.private-uat react-scripts start",
    "start:private-dev": "env-cmd -f .env.private-dev react-scripts start",
    "start:med-rd": "env-cmd -f .env.med-rd react-scripts start",
    "start:med-quindio": "env-cmd -f .env.med-quindio react-scripts start",
    "build:msj": "env-cmd -f .env.msj react-scripts build",
    "build:msj-uat": "env-cmd -f .env.msj-uat react-scripts build",
    "build:msj-dev": "env-cmd -f .env.msj-dev react-scripts build",
    "build:private": "env-cmd -f .env.private react-scripts build",
    "build:private-uat": "env-cmd -f .env.private-uat react-scripts build",
    "build:private-dev": "env-cmd -f .env.private-dev react-scripts build",
    "build:med-rd": "env-cmd -f .env.med-rd react-scripts build",
    "build:med-quindio": "env-cmd -f .env.med-quindio react-scripts build",
    "test": "node scripts/test.js",
    "analyze": "source-map-explorer build/static/js/main.*"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "resolver": "jest-pnp-resolver",
    "setupFiles": [
      "react-app-polyfill/jsdom"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.{js,jsx,ts,tsx}",
      "<rootDir>/src/**/?(*.)(spec|test).{js,jsx,ts,tsx}"
    ],
    "testEnvironment": "jsdom",
    "testURL": "http://localhost",
    "transform": {
      "^.+\\.(js|jsx|ts|tsx)$": "<rootDir>/node_modules/babel-jest",
      "^.+\\.css$": "<rootDir>/config/jest/cssTransform.js",
      "^(?!.*\\.(js|jsx|ts|tsx|css|json)$)": "<rootDir>/config/jest/fileTransform.js"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\].+\\.(js|jsx|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss)$"
    ],
    "moduleNameMapper": {
      "^react-native$": "react-native-web",
      "^.+\\.module\\.(css|sass|scss)$": "identity-obj-proxy"
    },
    "moduleFileExtensions": [
      "web.js",
      "js",
      "web.ts",
      "ts",
      "web.tsx",
      "tsx",
      "json",
      "web.jsx",
      "jsx",
      "node"
    ]
  },
  "babel": {
    "presets": [
      "react-app"
    ]
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  }
}
